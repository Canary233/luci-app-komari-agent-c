config komari-agent-c 'komari-agent-c'
	option token ''
	option endpoint ''
	option interval '3.0'
	option custom_dns ''
	option ignore_unsafe_cert '0'
	option disable_web_ssh '0'
	option max_retries '3'
	option reconnect_interval '5'
	option info_report_interval '5'
	option month_rotate '0'
	option include_nics ''
	option exclude_nics ''
	option include_mountpoints ''
	option custom_ipv4 ''
	option custom_ipv6 ''
	# Memory usage calculation (true/false, default false)
	option memory_include_cache '0'
	# Alias of memory_include_cache kept for Go flag parity (true/false)
	option memory_report_raw_used '0'
	# Preferred IP version for panel connections ('', '4' or '6')
	option prefer_ip_version ''
	# Auto-discovery key (optional, used for auto-registration to the panel)
	option auto_discovery_key ''
	# Disable compression (true/false, default false)
	option disable_compression '0'
	# Disable auto-update check (true/false, default false)
	option disable_auto_update '0'
