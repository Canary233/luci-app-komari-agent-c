#!/bin/sh /etc/rc.common

START=99
STOP=10

USE_PROCD=1
PROG=/usr/bin/komari-agent-c
NAME=komari-agent-c

validate_section() {
	uci_load_validate "$NAME" "$NAME" "main" "$2" \
		'token:string' \
		'endpoint:string' \
		'interval:float:3.0' \
		'custom_dns:string' \
		'ignore_unsafe_cert:bool:0' \
		'disable_web_ssh:bool:0' \
		'max_retries:uinteger:3' \
		'reconnect_interval:uinteger:5' \
		'info_report_interval:uinteger:5' \
		'month_rotate:uinteger:0' \
		'include_nics:string' \
		'exclude_nics:string' \
		'include_mountpoints:string' \
		'custom_ipv4:string' \
		'custom_ipv6:string' \
		'memory_include_cache:bool:0' \
		'memory_report_raw_used:bool:0' \
		'prefer_ip_version:string' \
		'auto_discovery_key:string' \
		'disable_compression:bool:0' \
		'disable_auto_update:bool:0'
}

start_instance() {
	[ "$2" = "0" ] || {
		echo "Validation failed"
		return 1
	}

	[ -z "$token" ] && {
		echo "Error: token is required"
		return 1
	}

	[ -z "$endpoint" ] && {
		echo "Error: endpoint is required"
		return 1
	}

	procd_open_instance
	procd_set_param command "$PROG"
	procd_append_param command --endpoint "$endpoint"
	procd_append_param command --interval "$interval"

	[ -n "$custom_dns" ] && procd_append_param command --dns "$custom_dns"
	[ "$ignore_unsafe_cert" = "1" ] && procd_append_param command --insecure
	[ "$disable_web_ssh" = "1" ] && procd_append_param command --disable-ssh

	# Drop root privileges to the dedicated komari system user/group when it
	# exists (created by postinst). If user creation failed on this system,
	# run as root rather than failing to spawn the instance entirely.
	if id komari >/dev/null 2>&1; then
		procd_set_param user komari
		procd_set_param group komari
	fi

	# Options without CLI flags are passed via environment variables consumed
	# by config_load_from_env() in src/config/config.c. All pairs MUST be
	# passed in a SINGLE procd_set_param env call: each call creates a fresh
	# "env" table that replaces the previous one, so with split calls only
	# the last pair would ever reach the process. The panel token is passed
	# here instead of a --token command line argument because
	# /proc/<pid>/cmdline is world-readable while /proc/<pid>/environ is
	# restricted to the process owner.
	set -- \
		AGENT_TOKEN="$token" \
		AGENT_MAX_RETRIES="$max_retries" \
		AGENT_RECONNECT_INTERVAL="$reconnect_interval" \
		AGENT_INFO_REPORT_INTERVAL="$info_report_interval" \
		AGENT_MONTH_ROTATE="$month_rotate" \
		AGENT_DISABLE_AUTO_UPDATE="$disable_auto_update" \
		AGENT_DISABLE_COMPRESSION="$disable_compression" \
		AGENT_MEMORY_INCLUDE_CACHE="$memory_include_cache" \
		AGENT_MEMORY_REPORT_RAW_USED="$memory_report_raw_used"
	[ -n "$include_nics" ] && set -- "$@" AGENT_INCLUDE_NICS="$include_nics"
	[ -n "$exclude_nics" ] && set -- "$@" AGENT_EXCLUDE_NICS="$exclude_nics"
	[ -n "$include_mountpoints" ] && set -- "$@" AGENT_INCLUDE_MOUNTPOINTS="$include_mountpoints"
	[ -n "$custom_ipv4" ] && set -- "$@" AGENT_CUSTOM_IPV4="$custom_ipv4"
	[ -n "$custom_ipv6" ] && set -- "$@" AGENT_CUSTOM_IPV6="$custom_ipv6"
	[ -n "$prefer_ip_version" ] && set -- "$@" AGENT_PREFER_IP_VERSION="$prefer_ip_version"
	[ -n "$auto_discovery_key" ] && set -- "$@" AGENT_AUTO_DISCOVERY_KEY="$auto_discovery_key"
	procd_set_param env "$@"

	procd_set_param respawn ${respawn_threshold:-3600} ${respawn_timeout:-5} ${respawn_retry:-5}
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

start_service() {
	validate_section "$NAME" start_instance
}

stop_service() {
	:
}

service_triggers() {
	procd_add_reload_trigger "$NAME"
	procd_add_validation validate_section
}
